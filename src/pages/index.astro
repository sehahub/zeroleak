---
import Base from '../layouts/Base.astro';

const checks = [
  {
    title: 'Text under redaction boxes',
    sev: 'critical',
    body: 'A black rectangle drawn over a name hides nothing. ZeroLeak reads the paint order, finds live text sitting beneath an opaque shape, and shows you the words it recovered.',
  },
  {
    title: 'Invisible text',
    sev: 'critical',
    body: 'Text can be written in a rendering mode that draws nothing at all. It stays fully searchable and copyable. Legitimate for scanned OCR, alarming everywhere else.',
  },
  {
    title: 'Earlier versions of the file',
    sev: 'critical',
    body: 'PDFs are often saved incrementally, appending each edit and keeping everything before it. Deleted paragraphs and corrected figures survive inside the same file.',
  },
  {
    title: 'Embedded files',
    sev: 'critical',
    body: 'Whole spreadsheets and documents can be stapled inside a PDF and travel with it. Most readers never show that they are there.',
  },
  {
    title: 'Document JavaScript',
    sev: 'critical',
    body: 'Code stored in the file runs when the document opens. It is used to signal that a file was received, and it is a standard delivery route for reader exploits.',
  },
  {
    title: 'Author, title and XMP metadata',
    sev: 'warning',
    body: 'Two separate metadata blocks record who made the file, with what software, and when. Clearing document properties usually leaves the XMP packet untouched.',
  },
  {
    title: 'Comments and filled form fields',
    sev: 'warning',
    body: 'Review threads carry the name of whoever wrote them, and form values live separately from the page you see on screen.',
  },
  {
    title: 'Content pushed off the page',
    sev: 'warning',
    body: 'Cropping changes what is displayed, not what is stored. Text moved past the page edge stays in the file and returns the moment the crop is undone.',
  },
];

const faqs = [
  {
    q: 'Is my file uploaded anywhere?',
    a: 'No. Scanning and cleaning both run inside your browser tab. Your PDF is never sent to a server, because there is no server-side code to send it to. You can verify this: load the page, disconnect from the network, and use it. It still works. The site keeps an aggregate count of page views (page, day, referring site — no cookies, no IP, no third party) and records nothing whatsoever about a document.',
  },
  {
    q: 'Why is drawing a black box over text not a redaction?',
    a: 'A PDF stores the text and the box as two independent objects. The box is painted after the text, so on screen the text disappears. The text object is untouched. Selecting the area and copying it, or running any text-extraction tool, returns the original words in full.',
  },
  {
    q: 'How does the cleaner make sure hidden text is really gone?',
    a: 'By not trying to be clever. Deleting individual text objects means calculating exactly which ones are covered, and an error there leaves readable text in a document you were told was safe. Instead, any page carrying hidden text is replaced with a flat picture of itself, so no text objects remain on it at all. Those pages look and print identically; they can no longer be selected or searched. Pages with nothing to hide are left exactly as they were.',
  },
  {
    q: 'Does the cleaner change my original file?',
    a: 'Never. You get a new copy in your downloads folder, named with a -cleaned suffix. The file on your disk is not touched. After cleaning you can scan the result in the same page to confirm it came out empty.',
  },
  {
    q: 'Does a clean report mean the document is safe to publish?',
    a: 'It means the structural leaks ZeroLeak knows how to detect are absent. It cannot judge whether the visible content itself should be public, and it does not read images — text burned into a scan is outside its reach. Treat it as one check in a review, not the whole review.',
  },
  {
    q: 'Can it open password-protected PDFs?',
    a: 'Not yet. Encrypted files are detected and reported as such, but their contents are not scanned.',
  },
  {
    q: 'How large a file can it handle?',
    a: 'Anything your browser can hold in memory. Documents beyond 60 pages are scanned to that depth by default to keep the tab responsive; the limit is a setting, not a hard constraint.',
  },
  {
    q: 'What does it cost?',
    a: 'Nothing, and there is no account. The web tool stays free — it costs nothing to run, because your machine does the work. Paid work will be a command-line version for teams that need this checked automatically on every outgoing document, which is a different problem from checking one file by hand.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="ZeroLeak — find and remove what your PDF is still leaking, without uploading it"
  description="Scan a PDF for text hidden under redaction boxes, invisible text, embedded files, retained earlier revisions and identifying metadata — then strip it all out. Runs entirely in your browser; the file is never uploaded."
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">The file never leaves this tab</span>
      <h1>See what your PDF is still carrying. Then take it out.</h1>
      <p class="lede">
        Drop in a document. ZeroLeak recovers the text sitting under redaction boxes, the earlier
        drafts still stored inside the file, the names in the metadata and the files embedded in it —
        shows you exactly what it found, and hands you a cleaned copy. Nothing is uploaded; all of it
        runs here, in your browser.
      </p>

      <div
        class="dropzone"
        id="dz"
        role="button"
        tabindex="0"
        aria-label="Choose a PDF to scan"
      >
        <div class="dz-title">Drop a PDF here</div>
        <div class="dz-sub">or paste one with ⌘V / Ctrl+V</div>
        <div class="dz-or"><span class="btn">Choose a file</span></div>
        <input type="file" id="file" accept="application/pdf,.pdf" class="sr" />
      </div>
      <p class="privacy-note">
        <span>No upload · No account · Free · Works offline</span>
      </p>

      <div id="status" class="status" hidden>
        <span id="status-text">Reading file…</span>
        <div class="bar"><i id="bar"></i></div>
      </div>

      <div id="report" class="report"></div>
    </div>
  </section>

  <section class="band" id="checks">
    <div class="wrap">
      <h2>What ZeroLeak looks for</h2>
      <p class="section-lede">
        Eight classes of content that are present in a PDF but absent from the page you see.
      </p>
      <div class="grid">
        {checks.map((c) => (
          <article class="card">
            <h3><span class={`chip ${c.sev}`}>{c.sev}</span>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="redaction">
    <div class="narrow prose">
      <h2>A black box is not a redaction</h2>
      <p>
        This is the single most repeated document-security failure, and it keeps happening to
        organisations with serious legal review processes — courts, regulators, national newspapers,
        government agencies. The mechanism is always the same.
      </p>
      <p>
        A PDF page is a list of drawing instructions. <strong>Write the words at this position</strong>,
        then <strong>fill this rectangle in black</strong>. A reader executes them in order, so the
        rectangle lands on top and the words vanish from view. But the instruction that writes the
        words is still in the file, unchanged. Every text-extraction tool ever written — including
        select-all and copy — reads the instructions, not the picture.
      </p>
      <p>
        Real redaction means the text itself has to stop existing. If your workflow is "insert a
        filled shape" in a PDF editor, a word processor, or an image annotation tool, you have not
        redacted anything. <strong>Scan the finished file before it goes out</strong> — that is what
        this page is for.
      </p>
    </div>
  </section>

  <section class="band" id="cleaning">
    <div class="narrow prose">
      <h2>How the cleaning works</h2>
      <p>
        Finding a leak is only useful if you can close it, so every report comes with a cleaner. It
        runs in the same tab, on the same file, and gives you back a new copy — your original is
        never modified.
      </p>
      <p>
        Metadata, embedded files, scripts and comments are simply deleted, along with every object
        that stops being referenced once they are gone. That last part matters more than it sounds:
        a PDF writer will happily carry orphaned objects into the output, so content you thought was
        removed can be written straight back into the "cleaned" file. Saving also rewrites the
        document as a single revision, which is what discards the earlier versions it was carrying.
      </p>
      <p>
        Hidden text gets different treatment. Deleting individual text objects means working out
        precisely which ones a box covers, and a miscalculation there hands you a file that has been
        declared safe while still carrying the words. So instead, <strong>any page with hidden text
        is replaced by a flat picture of itself</strong>. No text objects remain on it to recover.
        The page looks and prints exactly as before; it can no longer be selected or searched. Pages
        with nothing to hide are left untouched.
      </p>
      <p>
        You do not have to believe any of that. <strong>Scan the cleaned file</strong> — there is a
        button for it right after cleaning — and see the report come back empty.
      </p>
    </div>
  </section>

  <section class="band" id="privacy">
    <div class="narrow prose">
      <h2>Why "no upload" is a fact here, not a promise</h2>
      <p>
        Every other free PDF tool asks you to upload the document to a server you do not control. For
        a marketing brochure that is fine. For a settlement agreement, a patient record, or a source
        document you have promised to protect, it is disqualifying — the upload is itself the
        disclosure you were trying to prevent.
      </p>
      <p>
        ZeroLeak has no backend. The parser and the cleaner are compiled into the page and run in
        your browser; the site is static files on a CDN. There is nowhere for your document to be
        sent and nothing to store it in.
      </p>
      <p>
        You do not have to take that on trust. <strong>Open this page, disconnect your machine from
        the network, then scan and clean a file.</strong> Both still work. That is not something a
        server-based tool can do.
      </p>
      <p>
        For completeness, here is the one thing this site does record: when a page loads it adds 1 to
        a counter of <em>page, day, referring site</em>. No cookie, no IP address, no visitor
        identifier, no third-party analytics service. Nothing is recorded when you scan or clean a
        file — not the document, not its name, not what was found in it. That is the whole of it.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="narrow">
      <div class="signup">
        <h2>Checking one file at a time does not scale</h2>
        <p class="section-lede">
          If documents leave your organisation every day, the check belongs in the pipeline rather
          than in someone's browser. I am building a command-line version that runs the same scan on
          a folder, or on every file a build produces, and fails the run when something is still
          carrying hidden text. If that is a problem you have, leave an address — I will write once,
          when it is ready, and I would rather hear what you actually need before I finish it.
        </p>
        <form id="signup" novalidate>
          <input type="email" name="email" placeholder="you@firm.com" required aria-label="Email address" />
          <button class="btn" type="submit">Keep me posted</button>
        </form>
        <p class="note" id="signup-note">One email, when it ships. No newsletter, no sharing.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="narrow">
      <h2>Guides</h2>
      <p class="section-lede">
        Longer pieces on the problems this tool detects — written mostly because the existing advice
        on these topics is confidently wrong in ways that get people hurt.
      </p>
      <div class="more" style="margin-top:1.6rem">
        <ul>
          <li style="margin-top:1.1rem">
            <a href="/guides/redact-a-pdf-properly">How to redact a PDF so the text is actually gone</a>
            <span>— why a black box removes nothing, and the three methods that do</span>
          </li>
          <li style="margin-top:1.1rem">
            <a href="/guides/remove-pdf-metadata">How to remove metadata from a PDF</a>
            <span>— including the second block that most tools leave behind</span>
          </li>
          <li style="margin-top:1.1rem">
            <a href="/guides/hidden-content-in-pdfs">What can hide inside a PDF</a>
            <span>— a field guide to all eight kinds, and how each one gets there</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band" id="faq">
    <div class="narrow">
      <h2>Questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <script>
    import { mount } from '../scripts/app.ts';
    mount();
  </script>
</Base>
