{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroleak",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "routes": [
    { "pattern": "zeroleak.sehahub.info", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // No "ratelimits" binding here on purpose. It was tried: the binding deployed,
  // appeared in the bindings list, and limit() returned success for every
  // request — the ninth against a limit of five included. That is a known open
  // bug in the feature rather than a misconfiguration, and a guard that always
  // says yes is worse than none, because it reads as protection. Rate limiting
  // belongs in a WAF rule on the zone (Security > WAF > Rate limiting rules),
  // which runs at the edge and stores nothing.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroleak",
      "database_id": "b9b4d0c1-2bf2-4da1-bdc2-0ee4ee71a147"
    }
  ]
}
